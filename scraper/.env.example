# Skopiuj do .env i uzupełnij prawdziwymi wartościami
# Nigdy nie commituj .env

# Neon PostgreSQL — wersja direct (dla psycopg2, bez poolera)
DATABASE_URL=postgresql://neondb_owner:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# BGG Bearer Token (zarejestrowany na boardgamegeek.com/using_the_xml_api)
BGG_API_TOKEN=your-bgg-bearer-token-here

# GameUPC — klucz produkcyjny /v1 (mailem od maintainera, patrz
# docs/research/gameupc-api-registration.md). Zostaw pusty, jeśli go nie masz:
# brak klucza = ścieżka EAN wyłączona, co jest bezpiecznym stanem domyślnym.
# NIGDY nie wpisuj tu publicznego klucza demo (test_test_test_test_test) — zwraca
# spreparowane dane dla dowolnego EAN i zanieczyszcza bazę (incydent Story 2.2b).
GAMEUPC_API_KEY=

# Brevo API key (do wysyłania alertów cenowych)
BREVO_API_KEY=your-brevo-api-key-here

# Brevo sender identity (wymagane przez POST /v3/smtp/email)
BREVO_SENDER_EMAIL=powiadomienia@twoja-domena.pl
BREVO_SENDER_NAME=Agregator Cen Planszówek

# ISR revalidation — URL i secret Vercel
VERCEL_URL=https://twoja-domena.vercel.app
REVALIDATION_SECRET=your-revalidation-secret-here

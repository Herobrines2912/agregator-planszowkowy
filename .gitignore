# Claude Code — lokalne ustawienia i tooling (każdy instaluje sobie sam)
.claude/

# BMad — personalna konfiguracja użytkownika
_bmad/config.user.toml
_bmad/custom/config.user.toml

# Pliki robocze z sesji UX (drafty, nie finalne)
_bmad-output/**/. working/
_bmad-output/**/.working/

# Web (Next.js) — node_modules i env zarządzane przez web/.gitignore
web/node_modules/
web/.next/
web/.env.local

# Scraper (Python) — środowisko wirtualne uv
scraper/.venv/
scraper/.env

# Eksploracje i drafty tymczasowe
_tmp/

# Sekrety i dane lokalne
*.env.local
.env
